rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'marcos.mbr.1228@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health / Connection Test Document
    match /test/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Access Roles
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Sky & Astrophotography Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && incoming().title is string;
      allow update: if isSignedIn() && (
        existing().authorId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'savesCount', 'commentsCount']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
    }

    // Friendships & Chat Invitations Collection
    match /friendships/{friendshipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (incoming().requesterId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        existing().requesterId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        existing().requesterId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // E2EE Direct Messages Collection
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (incoming().senderId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Geolocation Telemetry for SkyMap
    match /telemetry/{telemetryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
