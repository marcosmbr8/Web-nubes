{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in OnlyCloud social network",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_]+$" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isAdmin": { "type": "boolean" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "twoFactorEnabled": { "type": "boolean" },
        "joinedDate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "displayName", "email"]
    },
    "Post": {
      "title": "Post",
      "description": "Sky and astrophotography publication",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 50 },
        "categoryLabel": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 120 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "title", "imageUrl", "category"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Friendship and chat invitation connection between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "requesterId": { "type": "string", "maxLength": 128 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["none", "pending_sent", "pending_received", "accepted", "rejected"] },
        "locationPermissionGranted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requesterId", "receiverId", "status"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Private message between friends with E2EE metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "ciphertext": { "type": "string", "maxLength": 2000 },
        "cleartextMessage": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "receiverId"]
    },
    "Telemetry": {
      "title": "Telemetry",
      "description": "Voluntary geolocation coordinate ping for interactive celestial sky map",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "geohash": { "type": "string", "maxLength": 12 },
        "locationName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "lat", "lng"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and account settings"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Community posts and celestial photography"
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Friend requests, accepted relationships, and location permissions"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Private E2EE direct chat messages between friends"
    },
    "/telemetry/{telemetryId}": {
      "schema": { "$ref": "#/entities/Telemetry" },
      "description": "Live GPS coordinates for friends with shared location permission"
    }
  }
}
